# Enlace público de la ficha de Clínica Bolívar en Google Maps.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://maps.app.goo.gl/Qjt9xkPTfEkLzey46

# Base de datos del formulario de feedback (docker compose).
# Cambia POSTGRES_PASSWORD antes de desplegar.
POSTGRES_DB=feedbackclinica
POSTGRES_USER=feedbackclinica
POSTGRES_PASSWORD=feedbackclinica

# Opcional: usar un PostgreSQL existente en lugar del contenedor "db".
# DATABASE_URL=postgres://usuario:clave@host:5432/base
